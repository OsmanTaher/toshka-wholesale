<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="shortcut icon" href="./image/logo.avif" type="image/x-icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
    <title>بيعلي جملة | نعود قريباً</title>
    <style>
      :root {
        --indigo: #4f46e5;
        --indigo-dark: #3730a3;
        --slate-900: #1e293b;
        --slate-600: #475569;
        --slate-100: #f1f5f9;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
        color: var(--slate-900);
        background-color: var(--slate-100);
        background-image:
          linear-gradient(rgba(79, 70, 229, 0.045) 1px, transparent 1px),
          linear-gradient(90deg, rgba(79, 70, 229, 0.045) 1px, transparent 1px);
        background-size: 32px 32px;
        font-family: "Tajawal", sans-serif;
        text-align: center;
        overflow: hidden;
      }

      .card {
        width: min(100%, 510px);
        padding: 38px 32px 34px;
        border: 1px solid rgba(148, 163, 184, 0.28);
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.92);
        box-shadow: 0 24px 70px rgba(30, 41, 59, 0.14);
        animation: appear 600ms ease both;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 30px;
        color: var(--indigo-dark);
        font-size: 20px;
        font-weight: 800;
      }

      .brand img {
        width: 46px;
        height: 46px;
        border-radius: 13px;
        object-fit: cover;
        box-shadow: 0 8px 18px rgba(79, 70, 229, 0.2);
      }

      .brand-icon {
        display: grid;
        width: 46px;
        height: 46px;
        place-items: center;
        border-radius: 13px;
        color: var(--indigo);
        background: #eef2ff;
        box-shadow: 0 8px 18px rgba(79, 70, 229, 0.2);
        font-size: 28px;
      }

      .status-icon {
        width: 82px;
        height: 82px;
        display: grid;
        place-items: center;
        margin: 0 auto 23px;
        border-radius: 50%;
        color: var(--indigo);
        background: #eef2ff;
        font-size: 38px;
      }

      h1 {
        margin-bottom: 13px;
        color: var(--slate-900);
        font-size: clamp(26px, 6vw, 34px);
        font-weight: 800;
        line-height: 1.25;
      }

      .lead {
        max-width: 390px;
        margin: 0 auto 22px;
        color: var(--slate-600);
        font-size: 16px;
        line-height: 1.9;
      }

      .note {
        display: inline-block;
        padding: 9px 15px;
        border-radius: 9px;
        color: var(--indigo-dark);
        background: #eef2ff;
        font-size: 14px;
        font-weight: 700;
      }

      .footer {
        margin-top: 29px;
        color: #94a3b8;
        font-size: 13px;
      }

      @keyframes appear {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (max-width: 420px) {
        body {
          padding: 16px;
        }
        .card {
          padding: 30px 21px 27px;
          border-radius: 20px;
        }
        .brand {
          margin-bottom: 24px;
        }
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="brand">
        <div class="brand-icon" aria-hidden="true">&#128722;</div>
        <span>متجر بيعلي جملة</span>
      </div>
      <div class="status-icon" aria-hidden="true">&#9881;</div>
      <h1>نجهّز لكم طلباتكم</h1>
      <p class="lead">
        نعمل على تأكيد الطلبات أو إلغائها وذلك بسبب ضغط الطلبات الكبير ، وتحديد
        إجمالي الكمية للطلب .
      </p>

      <div
        style="display: grid; gap: 12px; margin: 20px auto 0; max-width: 360px"
      >
        <div style="display: grid; gap: 10px">
          <button
            type="button"
            data-action="confirm"
            onclick="toggleQuickActionForm(this)"
            style="
              display: flex;
              align-items: center;
              justify-content: space-between;
              gap: 8px;
              border: none;
              border-radius: 12px;
              background: #dcfce7;
              color: #166534;
              font-weight: 800;
              font-size: 15px;
              padding: 12px 14px;
              cursor: pointer;
            "
          >
            <span style="display: inline-flex; align-items: center; gap: 8px">
              <span>✓</span>
              <span>تأكيد الطلب</span>
            </span>
            <span
              class="chevron"
              style="font-size: 12px; transition: transform 0.2s"
              >›</span
            >
          </button>
          <form
            data-quick-form="confirm"
            onsubmit="submitQuickAction(event)"
            style="
              display: none;
              gap: 12px;
              background: rgba(220, 252, 231, 0.8);
              border: 1px solid #bbf7d0;
              border-radius: 12px;
              padding: 12px;
            "
          >
            <input type="hidden" name="action" value="confirm" />
            <div>
              <label
                style="
                  display: block;
                  margin-bottom: 6px;
                  color: #334155;
                  font-size: 12px;
                  font-weight: 700;
                "
                >رقم الهاتف</label
              >
              <input
                name="phone"
                type="tel"
                required
                pattern="01(0|1|2|5)[0-9]{8}"
                maxlength="11"
                placeholder="011xxxxxxxx"
                style="
                  width: 100%;
                  padding: 10px 12px;
                  border-radius: 10px;
                  border: 1px solid #dbe2ea;
                  background: #fff;
                  font-size: 14px;
                  text-align: left;
                  direction: ltr;
                "
              />
            </div>
            <div>
              <label
                style="
                  display: block;
                  margin-bottom: 6px;
                  color: #334155;
                  font-size: 12px;
                  font-weight: 700;
                "
                >رقم الطلب</label
              >
              <input
                name="orderNumber"
                type="text"
                required
                pattern="[0-9]{4}"
                maxlength="4"
                placeholder="1234"
                style="
                  width: 100%;
                  padding: 10px 12px;
                  border-radius: 10px;
                  border: 1px solid #dbe2ea;
                  background: #fff;
                  font-size: 14px;
                  text-align: right;
                "
              />
            </div>
            <button
              type="submit"
              style="
                width: 100%;
                border: none;
                border-radius: 10px;
                background: #16a34a;
                color: #fff;
                font-weight: 800;
                font-size: 14px;
                padding: 10px 12px;
                cursor: pointer;
              "
            >
              تأكيد
            </button>
          </form>
        </div>

        <div style="display: grid; gap: 10px">
          <button
            type="button"
            data-action="cancel"
            onclick="toggleQuickActionForm(this)"
            style="
              display: flex;
              align-items: center;
              justify-content: space-between;
              gap: 8px;
              border: none;
              border-radius: 12px;
              background: #fee2e2;
              color: #991b1b;
              font-weight: 800;
              font-size: 15px;
              padding: 12px 14px;
              cursor: pointer;
            "
          >
            <span style="display: inline-flex; align-items: center; gap: 8px">
              <span>✕</span>
              <span>إلغاء الطلب</span>
            </span>
            <span
              class="chevron"
              style="font-size: 12px; transition: transform 0.2s"
              >›</span
            >
          </button>
          <form
            data-quick-form="cancel"
            onsubmit="submitQuickAction(event)"
            style="
              display: none;
              gap: 12px;
              background: rgba(254, 226, 226, 0.8);
              border: 1px solid #fecaca;
              border-radius: 12px;
              padding: 12px;
            "
          >
            <input type="hidden" name="action" value="cancel" />
            <div>
              <label
                style="
                  display: block;
                  margin-bottom: 6px;
                  color: #334155;
                  font-size: 12px;
                  font-weight: 700;
                "
                >رقم الهاتف</label
              >
              <input
                name="phone"
                type="tel"
                required
                pattern="01(0|1|2|5)[0-9]{8}"
                maxlength="11"
                placeholder="011xxxxxxxx"
                style="
                  width: 100%;
                  padding: 10px 12px;
                  border-radius: 10px;
                  border: 1px solid #dbe2ea;
                  background: #fff;
                  font-size: 14px;
                  text-align: left;
                  direction: ltr;
                "
              />
            </div>
            <div>
              <label
                style="
                  display: block;
                  margin-bottom: 6px;
                  color: #334155;
                  font-size: 12px;
                  font-weight: 700;
                "
                >رقم الطلب</label
              >
              <input
                name="orderNumber"
                type="text"
                required
                pattern="[0-9]{4}"
                maxlength="4"
                placeholder="1234"
                style="
                  width: 100%;
                  padding: 10px 12px;
                  border-radius: 10px;
                  border: 1px solid #dbe2ea;
                  background: #fff;
                  font-size: 14px;
                  text-align: right;
                "
              />
            </div>
            <button
              type="submit"
              style="
                width: 100%;
                border: none;
                border-radius: 10px;
                background: #dc2626;
                color: #fff;
                font-weight: 800;
                font-size: 14px;
                padding: 10px 12px;
                cursor: pointer;
              "
            >
              إلغاء
            </button>
          </form>
        </div>
      </div>

      <span class="note" style="margin-top: 24px">سنعود قريباً بإذن الله</span>
      <p class="footer">نشكركم على زيارتكم</p>
    </div>

    <script>
      function toggleQuickActionForm(button) {
        const action = button.dataset.action;
        const form = document.querySelector(`[data-quick-form="${action}"]`);
        const chevron = button.querySelector(".chevron");

        if (!form) return;

        const isOpen =
          form.style.display !== "none" && form.style.display !== "";
        document.querySelectorAll("[data-quick-form]").forEach((panel) => {
          panel.style.display = "none";
          const relatedButton = document.querySelector(
            `[data-action="${panel.dataset.quickForm}"]`,
          );
          const relatedChevron = relatedButton?.querySelector(".chevron");
          if (relatedChevron) relatedChevron.style.transform = "rotate(0deg)";
        });

        if (isOpen) {
          form.style.display = "none";
          if (chevron) chevron.style.transform = "rotate(0deg)";
          return;
        }

        form.style.display = "grid";
        if (chevron) chevron.style.transform = "rotate(90deg)";
        const firstInput = form.querySelector("input[name='phone']");
        if (firstInput) setTimeout(() => firstInput.focus(), 80);
      }

      async function submitQuickAction(event) {
        event.preventDefault();
        const form = event.currentTarget;
        const submitButton = form.querySelector('button[type="submit"]');
        const action = form.querySelector('input[name="action"]').value;
        const phone = form.querySelector('input[name="phone"]').value.trim();
        const orderNumber = form
          .querySelector('input[name="orderNumber"]')
          .value.trim();

        if (!/^01(0|1|2|5)\d{8}$/.test(phone)) {
          showToast(
            "أدخل رقم هاتف صحيحًا مكونًا من 11 رقمًا ويبدأ بـ 010 أو 011 أو 012 أو 015",
            "error",
          );
          return;
        }

        if (!/^\d{4}$/.test(orderNumber)) {
          showToast("يرجى إدخال رقم الطلب بشكل صحيح (4 أرقام فقط)", "error");
          return;
        }

        if (form.dataset.submitting === "true") return;

        form.dataset.submitting = "true";
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.style.opacity = "0.6";
          submitButton.style.cursor = "not-allowed";
        }

        try {
          const response = await fetch("/api/send-telegram", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              action,
              phone,
              orderNumber,
              source: "quick-action",
            }),
          });

          const result = await response.json();
          if (!response.ok || !result.success) {
            throw new Error(result.error || "تعذر تنفيذ العملية");
          }

          showToast(
            action === "cancel"
              ? "تم إرسال طلب الإلغاء بنجاح"
              : "تم إرسال تأكيد الطلب بنجاح",
            "success",
          );
        } catch (error) {
          showToast(error.message || "تعذر تنفيذ العملية", "error");
          form.dataset.submitting = "false";
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.style.opacity = "1";
            submitButton.style.cursor = "pointer";
          }
        }
      }

      function showToast(message, type = "info") {
        const container = document.getElementById("toastContainer");
        if (!container) return;

        const toast = document.createElement("div");
        const bgColor =
          type === "error"
            ? "background: #e11d48;"
            : type === "success"
              ? "background: #16a34a;"
              : "background: #0f172a;";
        const icon = type === "error" ? "⚠" : type === "success" ? "✓" : "ℹ";

        toast.style.cssText = `
          pointer-events: auto;
          color: white;
          border-radius: 12px;
          box-shadow: 0 16px 36px rgba(15, 23, 42, 0.18);
          display: flex;
          align-items: center;
          gap: 10px;
          max-width: 320px;
          padding: 12px 14px;
          font-size: 13px;
          font-weight: 700;
          opacity: 0;
          transform: translateY(8px);
          transition: all 0.3s ease;
          ${bgColor}
        `;

        toast.innerHTML = `
          <span style="font-size: 15px;">${icon}</span>
          <span style="flex: 1; line-height: 1.5;">${message}</span>
        `;

        container.appendChild(toast);
        requestAnimationFrame(() => {
          toast.style.opacity = "1";
          toast.style.transform = "translateY(0)";
        });

        setTimeout(() => {
          toast.style.opacity = "0";
          toast.style.transform = "translateY(8px)";
          setTimeout(() => toast.remove(), 300);
        }, 4000);
      }
    </script>
    <div
      id="toastContainer"
      style="
        position: fixed;
        left: 18px;
        bottom: 18px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        z-index: 9999;
        pointer-events: none;
      "
    ></div>
  </body>
</html>
