{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/image/logo.avif",
      "destination": "/image/logo.avif"
    },
    {
      "source": "/(.*)",
      "destination": "/maintenance.html"
    }
  ]
}